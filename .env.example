# ── Discord ───────────────────────────────────────────────────────────────
# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID da aplicação (Discord Developer Portal > sua aplicação > General Information > Application ID)
DISCORD_CLIENT_ID=

# ID do servidor (guild) onde o bot vai atuar. Clique com botão direito no
# servidor no Discord (com modo desenvolvedor ativado) > Copiar ID do Servidor
DISCORD_GUILD_ID=

# ID do canal onde o quadro mensal será postado automaticamente.
# Clique com botão direito no canal > Copiar ID do Canal
DISCORD_REPORT_CHANNEL_ID=

# ── VTLog ─────────────────────────────────────────────────────────────────
# Token de API da sua VTC (gerado em vtlog.net > sua VTC > Staff > API)
VTLOG_API_TOKEN=

# ID numérico da sua VTC (aparece na URL: vtlog.net/vtc/{ID}/...)
VTLOG_VTC_ID=8402

# Filtros usados no ranking GLOBAL do vtlog (empresa e motoristas).
# Já validados para esta VTC: board=Realistic, sub_board=MapaRBR, game=ETS2
VTLOG_GAME=ETS2
VTLOG_RANKING_BOARD=Realistic
VTLOG_RANKING_SUBBOARD=MapaRBR

# Métrica de pontuação: profit (lucro) ou distance (km)
VTLOG_RANKING_TYPE=profit

# Filtro de mapa usado para separar os jobs da empresa no ranking interno
# (validado: "ets2rbr" bate com o sub-board MapaRBR usado no ranking global).
# Deixe vazio (VTLOG_MAP=) se sua VTC não usa um mapa/mod específico.
VTLOG_MAP=ets2rbr

# Quantos motoristas aparecem no quadro individual (top N por lucro no mês)
REPORT_TOP_N=15

# ── Agendamento ───────────────────────────────────────────────────────────
# Expressão cron (formato node-cron: minuto hora dia-do-mês mês dia-da-semana),
# no fuso de VTLOG_TIMEZONE. Cron não tem "a cada 24h" literal — isso se faz
# escolhendo um horário fixo por dia. O relatório automático sempre reporta o
# MÊS ATUAL (em andamento), então o quadro vai atualizando dia a dia.
#
# Padrão: todo dia às 09:00.
REPORT_CRON=0 9 * * *
VTLOG_TIMEZONE=America/Sao_Paulo

# ── Painel / estado ───────────────────────────────────────────────────────
# Onde o bot salva o "último resumo" e qual mensagem é o painel ativo.
# Padrão: ./data/state.json (relativo à pasta do projeto).
# Se hospedar em algo com disco efêmero (ex.: Railway sem Volume), esse
# arquivo pode ser apagado a cada novo deploy — o bot continua funcionando
# normalmente, só "esquece" o último resumo/painel até gerar de novo.
# Veja o README (seção "Persistência") pra mais detalhes.
STATE_FILE_PATH=./data/state.json
